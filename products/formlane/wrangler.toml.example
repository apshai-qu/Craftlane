# Copy to worker/wrangler.toml (or rename next to this file and adjust main path).
# Docs: https://developers.cloudflare.com/workers/wrangler/configuration/

name = "formlane"
main = "worker/src/index.ts"
compatibility_date = "2024-09-23"

# Optional custom route after you attach a domain in the Cloudflare dashboard:
# routes = [{ pattern = "forms.example.com/*", zone_name = "example.com" }]

[vars]
# Comma-separated browser origins allowed to call the Worker. Use "*" only for demos.
ALLOWED_ORIGINS = "https://www.example.com,https://example.com"
HONEYPOT_FIELD = "website"
RATE_LIMIT_MAX = "5"
RATE_LIMIT_WINDOW_SEC = "60"

# Secrets (set via `wrangler secret put`, not in this file):
#   DISCORD_WEBHOOK_URL
#   SLACK_WEBHOOK_URL
#   GENERIC_WEBHOOK_URL
# Configure exactly one webhook URL.
