# Copy to worker/.dev.vars for local `wrangler dev`.
# Never commit real webhook URLs.

# Pick ONE:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/replace-me
# GENERIC_WEBHOOK_URL=https://example.com/hooks/formlane

ALLOWED_ORIGINS=*
HONEYPOT_FIELD=website
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=60
